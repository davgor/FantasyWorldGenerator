{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hero generator cast v2",
  "description": "The `heroes` block a finished world carries: people, dreads, realms, camps, relics, quest hooks, bonds, mantles and the precipitation roll ledger (including the hamlet, fortress, port and shrine wells) precipitated from the exported history. Structural envelope; deed ids, fame arithmetic and archetype preconditions are validated by the package's own tests. A failed block carries only version, status and error. Version 2 carries the quest contract on every hook -- anchor, verb, difficulty and the node a player stands on -- and no hook names a reward at any version.",
  "type": "object",
  "required": [
    "version",
    "status"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "error": {
      "type": "string"
    },
    "policy_revision": {
      "type": "object",
      "required": [
        "archetypes",
        "axis_overlays",
        "alignment",
        "names",
        "wells"
      ],
      "properties": {
        "archetypes": {
          "type": "integer",
          "minimum": 1
        },
        "axis_overlays": {
          "type": "integer",
          "minimum": 1
        },
        "alignment": {
          "type": "integer",
          "minimum": 1
        },
        "names": {
          "type": "integer",
          "minimum": 1
        },
        "wells": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "final_age": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "required": [
        "living",
        "legends",
        "dreads",
        "realms",
        "candidates",
        "precipitated",
        "camps",
        "hooks",
        "orgs"
      ],
      "properties": {
        "living": {
          "type": "integer",
          "minimum": 0
        },
        "legends": {
          "type": "integer",
          "minimum": 0
        },
        "dreads": {
          "type": "integer",
          "minimum": 0
        },
        "realms": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "precipitated": {
          "type": "integer",
          "minimum": 0
        },
        "camps": {
          "type": "integer",
          "minimum": 0
        },
        "hooks": {
          "type": "integer",
          "minimum": 0
        },
        "orgs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "dreads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dread"
      }
    },
    "realms": {
