      "required": [
        "role",
        "placed",
        "candidates",
        "sources",
        "source_kind",
        "reason"
      ],
      "properties": {
        "role": {
          "description": "A key of the wells policy's `precipitation` table. The table is the policy's own list, so a role that stops firing cannot drop out of the report by dropping out of the output.",
          "type": "string"
        },
        "placed": {
          "description": "How many of this role precipitated. For every role but `camp` these are records in `people` or `dreads`.",
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "description": "How many candidates were built and rolled. Equals the rows in `rolls` for this role, counting a diaspora's prophet, exile and founder together.",
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "description": "How many world records the well iterated before any roll. Greater than `candidates` when the well walked records that did not qualify, and zero when the world holds none of them at all.",
          "type": "integer",
          "minimum": 0
        },
        "source_kind": {
          "description": "What `sources` counted, in words, so the number is readable without opening the well.",
          "type": "string"
        },
        "reason": {
          "description": "Why the counts are what they are. Always present, whether or not anybody placed.",
          "type": "string"
        }
      }
