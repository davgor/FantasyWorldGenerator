    },
    "rolls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roll"
      }
    },
    "diagnostics": {
      "description": "One row per role declared in the wells policy, sorted by role, whether it placed anybody or not. A role that precipitated nobody says why, and says it in a way that separates the two zeros: `candidates` 0 means no candidate was ever built (the world holds none of the records the well reads), while `candidates` above 0 with `placed` 0 means every candidate rolled and lost. `camp` is the one role whose output is not a member of the cast: it precipitates into `camps`, not `people`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
