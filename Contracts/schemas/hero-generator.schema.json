    "quest_hook": {
      "type": "object",
      "description": "One offer. The quest contract is `target`/`target_node` (the anchor), `verb` (what the player does) and `difficulty` (how hard it is, 1-5 on the creature-tier rubric). There is deliberately no reward, loot or xp field at any version: the generator emits a difficulty and the consuming game prices it.",
      "required": [
        "hook_id",
        "giver_uid",
        "offered_from_face",
        "stated_purpose",
        "actual_effect",
        "unwitting",
        "target",
        "verb",
        "difficulty",
        "target_node",
        "unsited_reason"
      ],
      "properties": {
        "hook_id": {
          "type": "string"
        },
        "giver_uid": {
          "type": "string"
        },
        "offered_from_face": {
          "type": "string"
        },
        "stated_purpose": {
          "type": "string"
        },
        "actual_effect": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ruin",
                "city",
                "relic",
                "ley_node",
                "nest",
                "college",
                "hamlet",
                "fortress",
                "port",
                "shrine"
              ]
            },
            "uid": {
              "type": "string"
            },
            "node_id": {
              "type": "string"
            },
            "school": {
              "type": "string"
            },
            "intensity_delta": {
              "type": "number"
            },
            "action": {
              "type": "string"
            }
          }
        },
        "unwitting": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "The id of the thing the effect names: a uid, a ley node id, or a nest id."
        },
        "verb": {
          "enum": [
            "reclaim",
            "recover",
            "defend",
            "slay",
            "trade",
            "tend",
            "convert",
            "supply",
            "cleanse",
            "investigate"
          ],
          "description": "What the player does, from the same closed vocabulary npc_roster tags its posts with (npcs.verbs), so a hero-given hook and a post-given offer are the same kind of thing to a consumer. A ley effect carries no action of its own: deepening a node is tend and thinning one is cleanse."
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "How hard it is, on the creature-tier rubric this repository already publishes for beast_nests: 1 harmless, 2 can hurt you, 3 kills the careless, 4 kills the prepared, 5 a campaign threat. Derived as clamp(1, 5, floor(opposition + pressure + 0.5)) where opposition is what stands at the target (a lair's own tier, a ley node's own intensity, or a floor by what the place is) and pressure is 0.25 per tier of the worst nest whose declared range reaches the target's ground, capped at 1.0 and never applied to a nest target. It is a danger band, not an encounter simulation, and it is not a party-relative budget."
        },
        "target_node": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The terrain node a player stands on to do this, or null when the target has no footprint anywhere in the world. A ley key point, whose id is a ruin id plus -key, stands at that ruin; a bare ley node is a direction and an intensity and stands nowhere."
        },
        "unsited_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ley_node_has_no_site",
            "target_not_found",
            "target_has_no_node",
            null
          ],
          "description": "Why there is no target_node, or null when there is one. hero_generator.hooks.UNSITED_REASONS is the one home of this list."
        }
      }
    },
