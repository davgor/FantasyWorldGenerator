      }
    },
    "quest_hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quest_hook"
      }
    },
    "relics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relic"
      }
    },
    "bonds": {
      "type": "array",
      "items": {
