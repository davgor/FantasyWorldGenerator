{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantasy-world-generator.local/schemas/world-output.schema.json",
  "title": "FantasyWorldGenerator world output",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generator_version",
    "config",
    "layers",
    "recipe"
  ],
  "properties": {
    "schema": {
      "const": "fantasy-world-generator.world"
    },
    "schema_version": {
      "const": 2
    },
    "generator_version": {
      "const": 16
    },
    "config": {
      "type": "object"
    },
    "layers": {
      "type": "object",
      "properties": {
        "biome": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                13,
                15,
                16,
                17
              ]
            }
          }
        },
        "natural_biome": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                13,
                15,
                16,
                17
              ]
            }
          }
        },
        "biome_variant": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -1,
              "maximum": 103
            }
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "required": [
        "version",
        "seed",
        "resolved",
        "provenance"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "resolved": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "terrain": {
      "type": "object",
      "required": [
        "version",
        "biomes",
        "natural_biomes"
      ],
      "properties": {
        "version": {
          "const": 6
        },
        "biomes": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/naturalBiome"
          }
        },
        "natural_biomes": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/naturalBiome"
          }
        },
        "magical_biomes": {
          "type": "array",
          "minItems": 104,
          "maxItems": 104,
          "items": {
            "$ref": "#/$defs/magicalBiome"
          }
        }
      }
    },
    "settlements": {
      "type": "object",
      "required": [
        "version",
        "sites"
      ],
      "properties": {
        "version": {
          "const": 14
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "civilization_id",
              "population_profile",
              "city_class",
              "suitability"
            ],
            "properties": {
              "civilization_id": {
                "type": "string"
              },
              "population_profile": {
                "type": "string",
                "not": {
                  "enum": [
                    "human",
                    "highland",
                    "woodland",
                    "mixed"
                  ]
                }
              },
              "city_class": {
                "enum": [
                  "small",
                  "medium",
                  "capital"
                ]
              },
              "suitability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "civilizations": {
      "type": "object",
      "required": [
        "version",
        "entities"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "entities": {
          "type": "array"
        }
      }
    },
    "city_plans": {
      "type": "object",
      "required": [
        "version",
        "identity",
        "cities",
        "phase_order"
      ],
      "properties": {
        "version": {
          "const": 4
        },
        "identity": {
          "type": "object"
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "city_uid",
              "shape",
              "plots",
              "stats",
              "status",
              "version",
              "terrain",
              "bounds_m"
            ],
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "unbuildable"
                ]
              },
              "plots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "rotation_degrees",
                    "ground_elevation_m",
                    "foundation_bottom_m",
                    "dimensions_m",
                    "plot_m"
                  ],
                  "properties": {
                    "rotation_degrees": {
                      "type": "number"
                    },
                    "ground_elevation_m": {
                      "type": "number"
                    },
                    "foundation_bottom_m": {
                      "type": "number"
                    }
                  }
                }
              },
              "stats": {
                "type": "object"
              },
              "version": {
                "const": 4
              },
              "terrain": {
                "type": "object",
                "required": [
                  "cell_m",
                  "size",
                  "codes",
                  "surface"
                ],
                "properties": {
                  "surface": {
                    "type": "object",
                    "required": [
                      "size",
                      "step_m",
                      "heights_m"
                    ],
                    "properties": {
                      "size": {
                        "type": "integer",
                        "minimum": 2
                      },
                      "step_m": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "heights_m": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "phase_order": {
          "const": [
            "map",
            "shape",
            "high",
            "high_housing",
            "low",
            "low_housing"
          ]
        }
      }
    },
    "hamlet_plans": {
      "type": "object",
      "required": [
        "version",
        "identity",
        "hamlets",
        "phase_order"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "identity": {
          "type": "object"
        },
        "hamlets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hamlet_id",
              "shape",
              "plots",
              "stats",
              "status",
              "version",
              "terrain",
              "bounds_m"
            ],
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "unbuildable"
                ]
              },
              "kind": {
                "const": "hamlet"
              },
              "plots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "rotation_degrees",
                    "ground_elevation_m",
                    "foundation_bottom_m",
                    "dimensions_m",
                    "plot_m"
                  ],
                  "properties": {
                    "rotation_degrees": {
                      "type": "number"
                    },
                    "ground_elevation_m": {
                      "type": "number"
                    },
                    "foundation_bottom_m": {
                      "type": "number"
                    }
                  }
                }
              },
              "stats": {
                "type": "object"
              },
              "version": {
                "const": 1
              },
              "terrain": {
                "type": "object",
                "required": [
                  "cell_m",
                  "size",
                  "codes",
                  "surface"
                ],
                "properties": {
                  "surface": {
                    "type": "object",
                    "required": [
                      "size",
                      "step_m",
                      "heights_m"
                    ],
                    "properties": {
                      "size": {
                        "type": "integer",
                        "minimum": 2
                      },
                      "step_m": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "heights_m": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "phase_order": {
          "const": [
            "map",
            "shape",
            "high",
            "high_housing",
            "low",
            "low_housing"
          ]
        }
      }
    },
    "world_scene": {
      "type": "object",
      "required": [
        "version",
        "unit",
        "coordinates",
        "radius_m",
        "buildings",
        "streets",
        "junctions",
        "regional_roads"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "unit": {
          "const": "metres"
        },
        "buildings": {
          "type": "array"
        },
        "streets": {
          "type": "array"
        },
        "junctions": {
          "type": "array"
        },
        "regional_roads": {
          "type": "array"
        }
      }
    },
    "debug_stats": {
      "type": "object",
      "required": [
        "version",
        "cities",
        "diaspora"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cities": {
          "type": "array"
        },
        "diaspora": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "naturalBiome": {
      "type": "object",
      "required": [
        "id",
        "core",
        "name",
        "color",
        "asset_id"
      ],
      "properties": {
        "id": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            13,
            15,
            16,
            17
          ]
        },
        "core": {
          "enum": [
            "ocean",
            "tundra",
            "desert",
            "grassland",
            "forest",
            "exposed_rock",
            "snow",
            "rainforest",
            "lake",
            "marsh",
            "boreal_forest",
            "cold_tundra",
            "land_ice"
          ]
        },
        "name": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^terrain\\.biome\\.[0-9]{3}$"
        }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "magicalBiome": {
      "type": "object",
      "required": [
        "id",
        "core",
        "core_biome_id",
        "magic_school",
        "group",
        "descriptors",
        "name",
        "color",
        "asset_id"
      ],
      "properties": {
        "id": {
          "enum": [
            "ocean.weave",
            "ocean.umbral",
            "ocean.infernal",
            "ocean.radiant",
            "ocean.fire",
            "ocean.water",
            "ocean.earth",
            "ocean.air",
            "tundra.weave",
            "tundra.umbral",
            "tundra.infernal",
            "tundra.radiant",
            "tundra.fire",
            "tundra.water",
            "tundra.earth",
            "tundra.air",
            "desert.weave",
            "desert.umbral",
            "desert.infernal",
            "desert.radiant",
            "desert.fire",
            "desert.water",
            "desert.earth",
            "desert.air",
            "grassland.weave",
            "grassland.umbral",
            "grassland.infernal",
            "grassland.radiant",
            "grassland.fire",
            "grassland.water",
            "grassland.earth",
            "grassland.air",
            "forest.weave",
            "forest.umbral",
            "forest.infernal",
            "forest.radiant",
            "forest.fire",
            "forest.water",
            "forest.earth",
            "forest.air",
            "exposed_rock.weave",
            "exposed_rock.umbral",
            "exposed_rock.infernal",
            "exposed_rock.radiant",
            "exposed_rock.fire",
            "exposed_rock.water",
            "exposed_rock.earth",
            "exposed_rock.air",
            "snow.weave",
            "snow.umbral",
            "snow.infernal",
            "snow.radiant",
            "snow.fire",
            "snow.water",
            "snow.earth",
            "snow.air",
            "rainforest.weave",
            "rainforest.umbral",
            "rainforest.infernal",
            "rainforest.radiant",
            "rainforest.fire",
            "rainforest.water",
            "rainforest.earth",
            "rainforest.air",
            "lake.weave",
            "lake.umbral",
            "lake.infernal",
            "lake.radiant",
            "lake.fire",
            "lake.water",
            "lake.earth",
            "lake.air",
            "marsh.weave",
            "marsh.umbral",
            "marsh.infernal",
            "marsh.radiant",
            "marsh.fire",
            "marsh.water",
            "marsh.earth",
            "marsh.air",
            "boreal_forest.weave",
            "boreal_forest.umbral",
            "boreal_forest.infernal",
            "boreal_forest.radiant",
            "boreal_forest.fire",
            "boreal_forest.water",
            "boreal_forest.earth",
            "boreal_forest.air",
            "cold_tundra.weave",
            "cold_tundra.umbral",
            "cold_tundra.infernal",
            "cold_tundra.radiant",
            "cold_tundra.fire",
            "cold_tundra.water",
            "cold_tundra.earth",
            "cold_tundra.air",
            "land_ice.weave",
            "land_ice.umbral",
            "land_ice.infernal",
            "land_ice.radiant",
            "land_ice.fire",
            "land_ice.water",
            "land_ice.earth",
            "land_ice.air"
          ]
        },
        "core": {
          "enum": [
            "ocean",
            "tundra",
            "desert",
            "grassland",
            "forest",
            "exposed_rock",
            "snow",
            "rainforest",
            "lake",
            "marsh",
            "boreal_forest",
            "cold_tundra",
            "land_ice"
          ]
        },
        "core_biome_id": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            13,
            15,
            16,
            17
          ]
        },
        "magic_school": {
          "enum": [
            "weave",
            "umbral",
            "infernal",
            "radiant",
            "fire",
            "water",
            "earth",
            "air"
          ]
        },
        "group": {
          "type": "string"
        },
        "descriptors": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^terrain\\.mutation\\.[a-z_]+\\.[a-z]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
