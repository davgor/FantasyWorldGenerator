{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantasy-world-generator.local/schemas/world-output.schema.json",
  "title": "FantasyWorldGenerator world output",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generator_version",
    "config",
    "layers",
    "recipe"
  ],
  "properties": {
    "schema": { "const": "fantasy-world-generator.world" },
    "schema_version": { "const": 1 },
    "generator_version": { "type": "string", "minLength": 1 },
    "config": { "type": "object" },
    "layers": { "type": "object" },
    "recipe": {
      "type": "object",
      "required": ["version", "seed", "resolved", "provenance"],
      "properties": {
        "version": { "const": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "resolved": { "type": "object" },
        "provenance": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

