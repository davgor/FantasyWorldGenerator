{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beast movements v1",
  "description": "The `beast_movements` block: creatures whose species declares a movement class other than nester, and the circuits they walk. Groups share the shape of nomads.groups deliberately, so an encounter index or a time mover reads both with one code path. Structural envelope only; movement-class authoring is validated by Sim/tests/test_creature_movement.py.",
  "type": "object",
  "required": [
    "version",
    "groups",
    "counts",
    "routed",
    "stranded",
    "method",
    "limits"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "routed": {
      "type": "integer",
      "minimum": 0
    },
    "stranded": {
      "type": "integer",
      "minimum": 0,
      "description": "Groups whose circuit could not be built. Reported and kept with their start camp rather than dropped, so a quiet world is distinguishable from a broken pass."
    },
    "considered": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "method": {
      "type": "string"
    },
    "limits": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uid",
          "species_id",
          "movement",
          "node",
          "direction",
          "size",
          "speed_m_per_day",
          "column_length_m",
          "disposition",
          "camps",
          "legs",
          "route_status"
        ],
        "properties": {
          "uid": {
            "type": "string",
            "pattern": "^beastmove-[a-z0-9-]+-[0-9]+$"
          },
          "species_id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "movement": {
            "enum": [
              "migratory",
              "irruptive",
              "follower",
              "drifter"
            ]
          },
          "family": {
            "type": "string"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "kind": {
            "enum": [
              "animal",
              "monster"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "enum": [
              "wildlife",
              "beast_nests"
            ]
          },
          "host_uid": {
            "type": [
              "string",
              "null"
            ],
            "description": "For followers: the group whose circuit this one derives from. A nomad band or another creature group -- a follower does not search, it derives."
          },
          "node": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "z": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "speed_m_per_day": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "column_length_m": {
            "type": "number",
            "minimum": 0
          },
          "disposition": {
            "enum": [
              "hostile",
              "wary"
            ]
          },
          "route_status": {
            "enum": [
              "routed",
              "stranded"
            ]
          },
          "round_length_m": {
            "type": "number",
            "minimum": 0
          },
          "camps": {
            "type": "array",
            "minItems": 1
          },
          "legs": {
            "type": "array"
          }
        }
      }
    }
  }
}
