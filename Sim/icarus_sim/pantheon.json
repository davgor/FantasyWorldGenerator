     "arrangement": "Fire, Water, Earth and Air are high; Weave and Umbral are titans before the court; Radiant and Infernal are outsiders."},
    {"id": "cos_dual_dawn", "name": "Dawn and Pit", "requires": {"kind": "gods", "ids": ["god_radiant", "god_infernal"]},
     "weight": {"base": 2},
     "high": ["god_radiant", "god_infernal"], "arrangement": "Two high gods; every other god is a saint of one or a devil of the other."},
    {"id": "cos_ancestor_halls", "name": "The Ancestor Halls", "requires": {"kind": "races", "min": 2},
     "weight": {"base": 0, "fact": "races", "per": 1},
     "high": ["god_first_hearth", "god_elder_star", "god_deep_forge"], "arrangement": "Parent-race gods are high; school gods are impersonal powers with no temples."},
    {"id": "cos_spirits_of_place", "name": "Spirits of Place", "requires": {"kind": "any", "rules": [{"kind": "school", "school": "weave"}, {"kind": "school", "school": "earth"}]},
     "weight": {"base": 1.5},
     "high": [], "arrangement": "No high gods; every leyline key point is a named local spirit; civic gods are household spirits."},
    {"id": "cos_one_sun", "name": "The One Sun", "requires": {"kind": "any", "rules": [{"kind": "school", "school": "radiant"}, {"kind": "magic_disabled"}]},
     "weight": {"base": 1.5},
     "high": ["god_radiant", "god_crown_law"], "arrangement": "One over-god (Radiant Sovereign, else the Crowned Scale); all others become saints or angels."},
    {"id": "cos_silent_heavens", "name": "The Silent Heavens", "requires": {"kind": "any", "rules": [{"kind": "ruins", "min": 2}, {"kind": "school", "school": "umbral"}]},
     "weight": {"base": 0.5, "fact": "ruins", "per": 0.5},
     "high": ["god_fallen_cities", "god_wanderer"], "arrangement": "The gods are dead or withdrawn; only the Keeper of Fallen Cities, the Wanderer and cults of the Wild aspects are active."},
    {"id": "cos_sea_and_sky", "name": "Mother Sea, Father Sky", "requires": {"kind": "any", "rules": [{"kind": "gods", "ids": ["god_drowned_mother"]}, {"kind": "sky"}]},
     "weight": {"base": 1.5},
     "high": ["god_drowned_mother", "god_air", "god_sky_court"], "arrangement": "The Drowned Mother and Air (or the Sky Court) are the high pair; others are their children."},
    {"id": "cos_wyrm_thrones", "name": "The Wyrm Thrones", "requires": {"kind": "dragon"},
     "weight": {"base": 0, "fact": "dragons", "per": 1},
     "high": ["god_great_wyrm"], "arrangement": "The Great Wyrm is high; each dragon nest is a demigod with a territory."},
    {"id": "cos_the_woven", "name": "The Woven", "requires": {"kind": "school", "school": "weave"},
     "weight": {"base": 1.5},
     "high": ["god_weave"], "arrangement": "Magic itself is divine; the Loom-Mother is high and colleges are its churches."},
    {"id": "cos_turning_moon", "name": "The Turning Moon", "requires": {"kind": "magic_enabled"},
     "weight": {"base": 0, "fact": "lunar_influence", "per": 8},
     "high": ["god_turning_moon"], "arrangement": "The moon is high; each school god is one of its eight faces and the civic gods are its months."},
    {"id": "cos_mosaic", "name": "The Mosaic", "requires": {"kind": "always"},
     "weight": {"base": 0.5},
     "high": [], "arrangement": "No world-level high gods; each civilization ranks its own faith."}
  ],
