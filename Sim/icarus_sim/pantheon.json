{
  "schema": "fantasy-world-generator.pantheon",
  "schema_version": 1,
  "revision": 1,
  "description": "God catalogue and cosmology templates. Every god is independent: an existence rule evaluated against world state decides whether it is manifest, nothing inherits, and no god acts unless the orchestrator summons it.",
  "aspect_midpoint": 1.2,
  "nest_aspect_push": 0.15,
  "gods": [
    {"id": "god_weave", "family": "school", "name": "The Weave",
     "aspects": {"sovereign": "The Loom-Mother", "wild": "The Laughing Unmaker"},
     "domains": ["creation", "creativity", "chance", "magic itself"], "exists": {"kind": "school", "school": "weave"},
     "allies": ["god_air", "god_fortune_fate"], "rivals": ["god_umbral"], "school_affinity": ["weave"], "purge_families": [],
     "smite": "reality unpicked itself around the city; nothing of it holds a shape"},
    {"id": "god_umbral", "family": "school", "name": "The Umbral",
     "aspects": {"sovereign": "The Quiet Judge", "wild": "The Hollow Hunger"},
     "domains": ["death", "endings", "memory", "order"], "exists": {"kind": "school", "school": "umbral"},
     "allies": ["god_grave_memory"], "rivals": ["god_weave", "god_radiant"], "school_affinity": ["umbral"], "purge_families": ["holy", "fey"],
     "smite": "every hearth went cold in one night and the dead walked out of the gate"},
    {"id": "god_infernal", "family": "school", "name": "The Infernal",
     "aspects": {"sovereign": "The Chained Tyrant", "wild": "The Devourer Below"},
     "domains": ["ambition", "pacts", "ruin", "temptation"], "exists": {"kind": "school", "school": "infernal"},
     "allies": [], "rivals": ["god_radiant", "god_crown_law"], "school_affinity": ["infernal"], "purge_families": ["holy"],
     "smite": "the ground opened under the market and the city paid the price of its pacts"},
    {"id": "god_radiant", "family": "school", "name": "The Radiant",
     "aspects": {"sovereign": "The Dawn Healer", "wild": "The Burning Verdict"},
     "domains": ["healing", "light", "law", "judgement"], "exists": {"kind": "school", "school": "radiant"},
     "allies": ["god_crown_law"], "rivals": ["god_infernal", "god_umbral"], "school_affinity": ["radiant"], "purge_families": ["undead", "infernal", "unholy"],
     "smite": "a verdict of light burned the city to white ash"},
    {"id": "god_fire", "family": "school", "name": "The Fire",
     "aspects": {"sovereign": "The Hearth-Forger", "wild": "The Wildfire"},
     "domains": ["fire", "forge", "renewal", "passion"], "exists": {"kind": "school", "school": "fire"},
     "allies": ["god_forge_craft"], "rivals": ["god_water"], "school_affinity": ["fire"], "purge_families": ["undead"],
     "smite": "the city burned for nine days and the stones ran"},
    {"id": "god_water", "family": "school", "name": "The Water",
     "aspects": {"sovereign": "The Tide-Keeper", "wild": "The Winter Drowned"},
     "domains": ["sea", "rain", "ice", "patience"], "exists": {"kind": "school", "school": "water"},
     "allies": ["god_drowned_mother"], "rivals": ["god_fire"], "school_affinity": ["water"], "purge_families": ["infernal"],
     "smite": "the river turned in its bed and took the city with it"},
    {"id": "god_earth", "family": "school", "name": "The Earth",
     "aspects": {"sovereign": "The Green Grandmother", "wild": "The Titan Under the Hill"},
     "domains": ["harvest", "stone", "growth", "endurance"], "exists": {"kind": "school", "school": "earth"},
     "allies": ["god_hearth_harvest", "god_deep_forge"], "rivals": ["god_air"], "school_affinity": ["earth"], "purge_families": ["aberrant"],
     "smite": "the hill stood up and the city was under it"},
    {"id": "god_air", "family": "school", "name": "The Air",
     "aspects": {"sovereign": "The Wayfarer of Winds", "wild": "The Storm-Crown"},
     "domains": ["wind", "storms", "travel", "freedom"], "exists": {"kind": "school", "school": "air"},
     "allies": ["god_road_market", "god_wanderer"], "rivals": ["god_earth"], "school_affinity": ["air"], "purge_families": [],
     "smite": "a storm with a crown of lightning scattered the city across the plain"},

    {"id": "god_first_hearth", "family": "ancestor", "race": "human", "name": "The First Hearth",
     "aspects": {"sovereign": "The First Hearth"}, "domains": ["founding", "kinship", "the walled town"],
     "exists": {"kind": "race", "race": "human"},
     "epithets": {"human_maritime": "Harbour-Mother", "human_desert": "Well-Father", "human_cold": "Long-Night Keeper",
                  "human_large_island": "Shore-Ancestor", "human_rainforest": "Feathered Founder", "human_heartland": "The Old King"},
     "allies": ["god_hearth_harvest"], "rivals": [], "school_affinity": ["radiant"], "purge_families": [],
     "smite": "the founders' own walls closed on the city that forgot them"},
    {"id": "god_elder_star", "family": "ancestor", "race": "elf", "name": "The Elder Star",
     "aspects": {"sovereign": "The Elder Star"}, "domains": ["living wood", "long memory", "starlight"],
     "exists": {"kind": "race", "race": "elf"},
     "epithets": {"elf": "The Grove-Singer", "tidekin": "The Foam-Born"},
     "allies": ["god_weave"], "rivals": ["god_infernal"], "school_affinity": ["weave"], "purge_families": ["infernal"],
     "smite": "the woods remembered the city and grew through it in a season"},
    {"id": "god_deep_forge", "family": "ancestor", "race": "dwarf", "name": "The Deep Forge",
     "aspects": {"sovereign": "The Deep Forge"}, "domains": ["stone", "craft", "oaths", "hoard"],
     "exists": {"kind": "race", "race": "dwarf"},
     "epithets": {"dwarf": "The Anvil-Father", "gnome": "The Tinkering Spark", "hill_dwarf": "The Full Table", "frosthold_dwarf": "The Ember Under Ice"},
     "allies": ["god_earth", "god_fire"], "rivals": ["god_air"], "school_affinity": ["earth"], "purge_families": ["aberrant"],
     "smite": "the oath-breakers' halls were sealed in stone with everyone inside"},

    {"id": "god_drowned_mother", "family": "feature", "name": "The Drowned Mother",
     "aspects": {"sovereign": "The Drowned Mother"}, "domains": ["the sea", "fishing", "storms at sea", "drowning"],
     "exists": {"kind": "any", "rules": [{"kind": "ocean_share", "min": 0.5}, {"kind": "civilization_city", "ids": ["human_maritime", "human_large_island", "tidekin"]}]},
     "allies": ["god_water"], "rivals": ["god_fire"], "school_affinity": ["water"], "purge_families": ["infernal"],
     "smite": "the sea came up the streets and did not go back"},
    {"id": "god_sky_court", "family": "feature", "name": "The Sky Court",
     "aspects": {"sovereign": "The Sky Court"}, "domains": ["floating islands", "altitude", "the far view"],
     "exists": {"kind": "sky"},
     "allies": ["god_air"], "rivals": ["god_earth"], "school_affinity": ["air"], "purge_families": [],
     "smite": "the court sat in judgement above the city and let it fall from its favour"},
    {"id": "god_great_wyrm", "family": "feature", "name": "The Great Wyrm",
     "aspects": {"sovereign": "The Great Wyrm"}, "domains": ["dragons", "hoards", "fear", "fire from above"],
     "exists": {"kind": "dragon"},
     "allies": ["god_fire"], "rivals": ["god_crown_law"], "school_affinity": ["fire"], "purge_families": ["fey", "holy"],
     "smite": "the Wyrm took the city as its hoard and left the walls as its teeth"},
    {"id": "god_outer_unnamed", "family": "feature", "name": "The Unnamed Outside",
     "aspects": {"sovereign": "The Unnamed Outside"}, "domains": ["madness", "the wrong shape of things", "forbidden knowledge"],
     "exists": {"kind": "nest_family", "families": ["aberrant"]},
     "allies": [], "rivals": ["god_radiant", "god_earth"], "school_affinity": ["weave", "umbral"], "purge_families": ["holy", "fey", "primordial"],
     "smite": "the city is still there, but its angles are wrong and nobody who enters comes back the same"},
    {"id": "god_fallen_cities", "family": "feature", "name": "The Keeper of Fallen Cities",
     "aspects": {"sovereign": "The Keeper of Fallen Cities"}, "domains": ["ruins", "lost knowledge", "warnings"],
     "exists": {"kind": "ruins", "min": 1},
     "allies": ["god_grave_memory"], "rivals": [], "school_affinity": ["umbral"], "purge_families": [],
     "smite": "the Keeper added one more name to the list"},
    {"id": "god_wanderer", "family": "feature", "name": "The Wanderer",
     "aspects": {"sovereign": "The Wanderer"}, "domains": ["exile", "roads between peoples", "second chances"],
     "exists": {"kind": "diaspora"},
     "allies": ["god_air", "god_road_market"], "rivals": [], "school_affinity": ["air"], "purge_families": [],
     "smite": "the roads left the city and its people followed them"},
    {"id": "god_turning_moon", "family": "feature", "name": "The Turning Moon",
     "aspects": {"sovereign": "The Pale Warden", "wild": "The Turning Face"},
     "domains": ["the moon", "tides of magic", "calendars", "the great year"],
     "exists": {"kind": "always"},
     "allies": ["god_fortune_fate"], "rivals": [], "school_affinity": ["moon"], "purge_families": [],
     "festival": "full moons; hollow nights are dread for every faith but the Wild Umbral and Infernal cults, who keep them as vigils",
     "smite": "every school surged at once under a moon that filled half the sky, and the city could not stand it"},

    {"id": "god_hearth_harvest", "family": "civic", "name": "The Hearth and the Harvest",
     "aspects": {"sovereign": "The Hearth and the Harvest"}, "domains": ["home", "bread", "children"],
     "exists": {"kind": "always"}, "folds_into": "god_earth",
     "allies": ["god_earth"], "rivals": ["god_red_field"], "school_affinity": ["earth"], "purge_families": ["undead"],
     "smite": "the fields refused the city and the hearths would not light"},
    {"id": "god_forge_craft", "family": "civic", "name": "The Maker",
     "aspects": {"sovereign": "The Maker"}, "domains": ["tools", "walls", "guilds"],
     "exists": {"kind": "always"}, "folds_into": "god_fire",
     "allies": ["god_fire", "god_deep_forge"], "rivals": [], "school_affinity": ["fire"], "purge_families": [],
     "smite": "every wall the city ever raised came down in the same hour"},
    {"id": "god_road_market", "family": "civic", "name": "The Coin and the Road",
     "aspects": {"sovereign": "The Coin and the Road"}, "domains": ["trade", "oaths between strangers", "travel"],
     "exists": {"kind": "always"}, "folds_into": "god_air",
     "allies": ["god_air", "god_wanderer"], "rivals": [], "school_affinity": ["air"], "purge_families": [],
     "smite": "no road led to the city any more, and it starved in sight of its neighbours"},
    {"id": "god_crown_law", "family": "civic", "name": "The Crowned Scale",
     "aspects": {"sovereign": "The Crowned Scale"}, "domains": ["kingship", "law", "treaties"],
     "exists": {"kind": "always"}, "folds_into": "god_radiant",
     "allies": ["god_radiant"], "rivals": ["god_infernal", "god_great_wyrm"], "school_affinity": ["radiant"], "purge_families": ["infernal"],
     "smite": "the Scale found the city wanting and the sentence was carried out at once"},
    {"id": "god_grave_memory", "family": "civic", "name": "The Grave Keeper",
     "aspects": {"sovereign": "The Grave Keeper"}, "domains": ["natural death", "ancestors", "remembrance"],
     "exists": {"kind": "always"}, "folds_into": "god_umbral",
     "allies": ["god_umbral", "god_fallen_cities"], "rivals": [], "school_affinity": ["umbral"], "purge_families": ["undead"],
     "smite": "the ancestors rose to reclaim what the living had squandered"},
    {"id": "god_fortune_fate", "family": "civic", "name": "The Turning Wheel",
     "aspects": {"sovereign": "The Turning Wheel"}, "domains": ["luck", "weather", "fate"],
     "exists": {"kind": "always"}, "folds_into": "god_weave",
     "allies": ["god_weave", "god_turning_moon"], "rivals": [], "school_affinity": ["weave"], "purge_families": [],
     "smite": "the wheel turned once and the city's luck ran out all together"},
    {"id": "god_red_field", "family": "civic", "name": "The Red Field",
     "aspects": {"sovereign": "The Red Field"}, "domains": ["war", "courage", "the honoured dead"],
     "exists": {"kind": "always"},
     "allies": [], "rivals": ["god_hearth_harvest"], "school_affinity": ["fire", "infernal"], "purge_families": [],
     "smite": "the city fought a war with no enemy and lost it"}
