{
  "description": "Source local metres (east, up, north) to Unreal centimetres (east, north, up). Hand-authored; do not regenerate from an Unreal session. Kernel JSON excludes floats, so a source offset is a JSON integer or an exact decimal string and centimetres are exact integers. Float consumers: relative 1e-12, absolute 1e-9.",
  "mapping": {
    "unreal_x": "east_m * 100",
    "unreal_y": "north_m * 100",
    "unreal_z": "up_m * 100",
    "scale_unit_axes": false,
    "winding": "reverse source indices for left-handed Unreal"
  },
